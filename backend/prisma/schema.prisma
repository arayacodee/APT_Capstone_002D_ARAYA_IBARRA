generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  SUPERADMIN
}

enum BusinessCategory {
  GENERAL
  WELLNESS
  BEAUTY
}

enum AttentionMode {
  ONSITE
  ONLINE
  BOTH
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  role         UserRole
  googleId     String?       @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?
  address      String?
  phoneVerifiedAt DateTime?
  pendingVerificationSid String?
  phoneVerificationSentAt DateTime?
  professionalApplication ProfessionalApplication?

  businesses   Business[]
  reservations Reservation[]
  clientSessions ClientSession[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProfessionalApplication {
  id String @id @default(uuid())
  userId String @unique
  businessName String
  category BusinessCategory @default(GENERAL)
  description String?
  monthlyPrice Int @default(7900)
  currency String @default("CLP")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  photos BusinessPhoto[]
  id             String         @id @default(uuid())
  name           String
  description    String?
  category       BusinessCategory @default(GENERAL)
  professionalName String?
  specialties    String?
  address        String?
  attentionMode  AttentionMode?
  timezone       String @default("America/Santiago")
  ownerId        String

  avatarUrl      String?
  avatarPublicId String?
  coverUrl       String?
  coverPublicId  String?

  owner          User           @relation(fields: [ownerId], references: [id])
  services       Service[]
  availabilities Availability[]
  reservations   Reservation[]
  clientSessions ClientSession[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model BusinessPhoto {
  id String @id @default(uuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  imageUrl String
  imagePublicId String
  caption String?
  createdAt DateTime @default(now())
  @@index([businessId, createdAt])
}


model Service {
  id           String        @id @default(uuid())
  businessId   String
  name         String
  description  String?
  durationMin  Int
  price        Decimal       @db.Decimal(10, 2)
  isActive     Boolean       @default(true)

  business     Business      @relation(fields: [businessId], references: [id])
  reservations Reservation[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Availability {
  id          String   @id @default(uuid())
  businessId  String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isActive    Boolean  @default(true)

  business    Business @relation(fields: [businessId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reservation {
  id          String            @id @default(uuid())
  businessId  String
  serviceId   String
  clientId    String

  startsAt    DateTime
  endsAt      DateTime
  status      ReservationStatus @default(CONFIRMED)

  business    Business          @relation(fields: [businessId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
  client      User              @relation(fields: [clientId], references: [id])

  clientSession ClientSession?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([businessId, startsAt])
  @@index([clientId])
}

model ClientSession {
  id String @id @default(uuid())

  businessId    String
  clientId      String
  reservationId String @unique

  occurredAt DateTime
  notes      String?

  // Cada atención pertenece a un negocio, un cliente y una reserva concreta.
  // reservationId es único para impedir dos historiales para la misma reserva.
  business    Business    @relation(fields: [businessId], references: [id])
  client      User        @relation(fields: [clientId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  evidences SessionEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, clientId])
  @@index([occurredAt])
}

model SessionEvidence {
  id String @id @default(uuid())

  sessionId String

  imageUrl      String
  imagePublicId String

  caption String?

  // Las evidencias pertenecen a una atención concreta.
  // Si la sesión se elimina, sus evidencias también se eliminan.
  session ClientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId])
}
